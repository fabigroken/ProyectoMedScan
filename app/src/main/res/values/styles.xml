<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="BotonMedScan" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_button_blue</item>
        <item name="android:textColor">@color/btn_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="LogoFooter">
        <item name="android:layout_width">88dp</item>
        <item name="android:layout_height">88dp</item>
        <item name="android:layout_gravity">end</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:contentDescription">Logo MedScan</item>
        <item name="android:alpha">0.96</item>
    </style>

    <style name="TituloPantalla">
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:shadowColor">#77000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">5</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="SubtituloPantalla">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#F3FAFF</item>
        <item name="android:alpha">0.95</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="EtiquetaCampo">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
    </style>

    <style name="CampoTexto">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_medscan_surface</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:padding">8dp</item>
    </style>

</resources>
