<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="14dp"
    android:paddingBottom="8dp"
    android:background="@drawable/bg_medscan_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="@drawable/bg_medscan_surface">

        <Button
            android:id="@+id/btnVolver"
            style="@style/BotonMedScan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Volver" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TituloPantalla"
            android:text="DETALLE MEDICAMENTO"
            android:fontFamily="serif"
            android:paddingTop="12dp"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/EtiquetaCampo"
            android:text="ID" />

        <EditText
            android:id="@+id/etId"
            style="@style/CampoTexto"
            android:enabled="false"
            android:focusable="false"
            android:cursorVisible="false"
            android:longClickable="false"
            android:inputType="none" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/EtiquetaCampo"
            android:layout_marginTop="10dp"
            android:text="NOMBRE" />

        <EditText
            android:id="@+id/etNombre"
            style="@style/CampoTexto"
            android:focusable="false"
            android:cursorVisible="false"
            android:longClickable="false"
            android:inputType="none" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/EtiquetaCampo"
            android:layout_marginTop="10dp"
            android:text="PRINCIPIO ACTIVO" />

        <EditText
            android:id="@+id/etPrincipioActivo"
            style="@style/CampoTexto"
            android:focusable="false"
            android:cursorVisible="false"
            android:longClickable="false"
            android:inputType="none" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/EtiquetaCampo"
            android:layout_marginTop="10dp"
            android:text="FRECUENCIA Y CANTIDAD" />

        <EditText
            android:id="@+id/etFrecuencia"
            style="@style/CampoTexto"
            android:focusable="false"
            android:cursorVisible="false"
            android:longClickable="false"
            android:inputType="none" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/EtiquetaCampo"
            android:layout_marginTop="10dp"
            android:text="PARA QUE SIRVE" />

        <EditText
            android:id="@+id/etParaQueSirve"
            style="@style/CampoTexto"
            android:focusable="false"
            android:cursorVisible="false"
            android:longClickable="false"
            android:inputType="none" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/EtiquetaCampo"
            android:layout_marginTop="10dp"
            android:text="CONTRAINDICACIONES" />

        <EditText
            android:id="@+id/etContraindicaciones"
            style="@style/CampoTexto"
            android:focusable="false"
            android:cursorVisible="false"
            android:longClickable="false"
            android:inputType="none" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/EtiquetaCampo"
            android:layout_marginTop="10dp"
            android:text="EFECTOS SECUNDARIOS" />

        <EditText
            android:id="@+id/etEfectosSecundarios"
            style="@style/CampoTexto"
            android:focusable="false"
            android:cursorVisible="false"
            android:longClickable="false"
            android:inputType="none" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/EtiquetaCampo"
            android:layout_marginTop="10dp"
            android:text="ADVERTENCIAS" />

        <EditText
            android:id="@+id/etAdvertencias"
            style="@style/CampoTexto"
            android:focusable="false"
            android:cursorVisible="false"
            android:longClickable="false"
            android:inputType="none" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/EtiquetaCampo"
            android:layout_marginTop="10dp"
            android:text="REQUIERE RECETA" />

        <EditText
            android:id="@+id/etReceta"
            style="@style/CampoTexto"
            android:focusable="false"
            android:cursorVisible="false"
            android:longClickable="false"
            android:inputType="none" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/EtiquetaCampo"
            android:layout_marginTop="10dp"
            android:text="LABORATORIO" />

        <EditText
            android:id="@+id/etLaboratorio"
            style="@style/CampoTexto"
            android:focusable="false"
            android:cursorVisible="false"
            android:longClickable="false"
            android:inputType="none" />

        <Button
            android:id="@+id/btnEliminar"
            style="@style/BotonMedScan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:text="Eliminar" />

        <ImageView
            android:id="@+id/ivLogoFooterDetalle"
            style="@style/LogoFooter"
            android:background="@drawable/bg_logo_circle"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:clipToOutline="true"
            android:src="@drawable/logo_medscan" />

    </LinearLayout>
</ScrollView>
