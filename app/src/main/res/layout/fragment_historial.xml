<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="12dp"
    android:background="@drawable/bg_medscan_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="@drawable/bg_medscan_surface">

        <Button
            android:id="@+id/btnVolver"
            style="@style/BotonMedScan"
            android:layout_width="wrap_content"
            android:text="Volver" />

        <TextView
            android:id="@+id/tvTituloHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TituloPantalla"
            android:fontFamily="serif"
            android:text="HISTORIAL MEDSCAN"
            android:paddingTop="12dp"
            android:paddingBottom="10dp" />

        <TextView
            android:id="@+id/tvEmptyHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No hay medicamentos guardados."
            android:gravity="center"
            android:textColor="@color/white"
            android:visibility="gone"
            android:paddingBottom="8dp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistorial"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_medscan_surface"
        android:padding="8dp" />

    <ImageView
        android:id="@+id/ivLogoFooterHistorial"
        style="@style/LogoFooter"
        android:background="@drawable/bg_logo_circle"
        android:padding="2dp"
        android:scaleType="fitCenter"
        android:clipToOutline="true"
        android:src="@drawable/logo_medscan" />

</LinearLayout>
