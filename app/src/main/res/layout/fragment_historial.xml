<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/colorBackground">
    <!-- Botón para volver -->
    <Button
        android:id="@+id/btnVolver"
        style="@style/BotonMedScan"
        android:layout_width="wrap_content"
        android:text="← Volver" />
    <!-- Título del historial -->
    <TextView
        android:id="@+id/tvTituloHistorial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TituloPantalla"
        android:text="HISTORIAL DE MEDICAMENTOS"
        android:paddingTop="12dp"
        android:paddingBottom="12dp" />
    <!-- Mensaje cuando no hay medicamentos -->
    <TextView
        android:id="@+id/tvEmptyHistorial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No hay medicamentos guardados."
        android:gravity="center"
        android:textColor="@color/colorTextSecondary"
        android:visibility="gone"
        android:paddingBottom="8dp" />
    <!-- Lista del historial -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistorial"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
