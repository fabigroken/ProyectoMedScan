<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="16dp"
    android:background="@drawable/bg_medscan_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="@drawable/bg_medscan_surface">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TituloPantalla"
            android:text="MedScan"
            android:fontFamily="serif" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/SubtituloPantalla"
            android:text="PANTALLA DE ESCANEO"
            android:paddingTop="4dp"
            android:paddingBottom="20dp" />

        <Button
            android:id="@+id/btnIrHistorial"
            style="@style/BotonMedScan"
            android:layout_width="match_parent"
            android:text="Ver historial" />

        <Button
            android:id="@+id/btnIrEscaneoIA"
            style="@style/BotonMedScan"
            android:layout_width="match_parent"
            android:layout_marginTop="14dp"
            android:text="Escanear medicamento (IA)" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ImageView
        android:id="@+id/ivLogoFooterEscaneo"
        style="@style/LogoFooter"
        android:background="@drawable/bg_logo_circle"
        android:padding="2dp"
        android:scaleType="fitCenter"
        android:clipToOutline="true"
        android:src="@drawable/logo_medscan" />

</LinearLayout>
