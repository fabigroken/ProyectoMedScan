<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="16dp"
    android:background="@drawable/bg_medscan_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_medscan_surface">

        <Button
            android:id="@+id/btnVolver"
            style="@style/BotonMedScan"
            android:layout_width="wrap_content"
            android:text="Volver" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TituloPantalla"
            android:text="ESCANEO IA"
            android:fontFamily="serif"
            android:paddingTop="10dp"
            android:paddingBottom="14dp" />

        <Button
            android:id="@+id/botonOCR"
            style="@style/BotonMedScan"
            android:layout_width="match_parent"
            android:text="Escanear texto" />

        <Button
            android:id="@+id/botonBarcode"
            style="@style/BotonMedScan"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:text="Escanear codigo de barras" />
    </LinearLayout>

    <TextView
        android:id="@+id/textoResultado"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_medscan_surface"
        android:padding="14dp"
        android:text="Resultado aqui"
        android:textColor="@color/colorTextPrimary" />

    <ImageView
        android:id="@+id/ivLogoFooterEscaneoIa"
        style="@style/LogoFooter"
        android:background="@drawable/bg_logo_circle"
        android:padding="2dp"
        android:scaleType="fitCenter"
        android:clipToOutline="true"
        android:src="@drawable/logo_medscan" />

</LinearLayout>
