<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal"
    android:background="@color/colorBackground">
    <!-- Botón para volver atrás -->
    <Button
        android:id="@+id/btnVolver"
        style="@style/BotonMedScan"
        android:layout_width="wrap_content"
        android:layout_gravity="start"
        android:text="← Volver" />
    <!-- Título de la pantalla -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TituloPantalla"
        android:text="ESCANEO IA"
        android:paddingTop="12dp"
        android:paddingBottom="16dp" />
    <!-- Botón para escanear texto con OCR -->
    <Button
        android:id="@+id/botonOCR"
        style="@style/BotonMedScan"
        android:text="Escanear texto" />
    <!-- Botón para escanear código de barras -->
    <Button
        android:id="@+id/botonBarcode"
        style="@style/BotonMedScan"
        android:layout_marginTop="12dp"
        android:text="Escanear código de barras" />
    <!-- Resultado-->
    <TextView
        android:id="@+id/textoResultado"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="20dp"
        android:text="Resultado aquí"
        android:textColor="@color/colorTextPrimary" />
</LinearLayout>
