<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RESULTADO DEL MEDICAMENTO"
            android:textStyle="bold"
            android:textSize="27sp"
            android:gravity="center"
            android:paddingBottom="24dp" />

        <TextView
            android:id="@+id/tvResultadoNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre: Ibuprofeno 600"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvResultadoPrincipio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Principio activo: Ibuprofeno"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvResultadoDosis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Dosis recomendada: 1 comprimido cada 8 horas"
            android:textSize="16sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="28dp" />

        <Button
            android:id="@+id/btnGuardarDemo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="GUARDAR EN FIRESTORE"
            android:textAllCaps="false"
            android:textColor="@color/btn_text"
            android:textSize="14sp"
            app:backgroundTint="@color/btn_blue_dark"
            android:backgroundTintMode="src_in" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="14dp" />

        <Button
            android:id="@+id/btnIrHistorialDesdeResultado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="IR A HISTORIAL"
            android:textAllCaps="false"
            android:textColor="@color/btn_text"
            android:textSize="14sp"
            app:backgroundTint="@color/btn_blue_dark"
            android:backgroundTintMode="src_in" />
    </LinearLayout>
</ScrollView>



